{
  "name": "floralis-pdv-erp",
  "version": "1.0.1",
  "private": true,
  "description": "Aplicativo unificado FLORALES PDV & ERP para Windows, Android e PWA.",
  "main": "native/electron/main.cjs",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "site:build": "node scripts/prepare-site.mjs",
    "native:prepare": "node scripts/prepare-native.mjs",
    "desktop:start": "npm run native:prepare && electron .",
    "desktop:build": "npm run native:prepare && electron-builder --win nsis portable --publish never",
    "android:add": "npm run native:prepare && cap add android",
    "android:sync": "npm run native:prepare && cap sync android",
    "android:build": "npm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/app": "8.1.1",
    "@capacitor/cli": "8.5.0",
    "@capacitor/core": "8.5.0",
    "@capgo/capacitor-printer": "8.1.3",
    "electron": "44.0.0",
    "electron-builder": "26.15.3"
  },
  "overrides": {
    "uuid": "11.1.1"
  },
  "build": {
    "appId": "com.floralis.pdverp",
    "productName": "FLORALES PDV ERP",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-native/**/*",
      "native/electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon-512.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "FLORALIS-PDV-ERP-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FLORALES PDV ERP"
    },
    "portable": {
      "artifactName": "FLORALIS-PDV-ERP-Portable-${version}-${arch}.${ext}"
    }
  }
}
